{
  "name": "api-kinedpoche",
  "version": "1.0.0",
  "description": "A simple Express application built with TypeScript",
  "main": "build/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/app.js",
    "dev": "nodemon",
    "test:live": "node test/runLiveTest.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/dataSource.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/dataSource.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/dataSource.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "pg": "^8.4.0",
    "reflect-metadata": "^0.1.13",
    "typeorm": "0.3.21"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.11",
    "axios": "^1.13.2",
    "nodemon": "^3.1.9",
    "ts-node": "10.9.1",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
